---
import { book } from '../config/book';
---
<a class="book-teaser" href="/libro/" target="_blank" rel="noopener noreferrer" aria-label={`${book.title}. Conocé el libro de Solange Jure Ramos (abre en una pestaña nueva)`}>
  <picture>
    <source srcset="/images/libro-sin-fondo-480.webp" type="image/webp"/>
    <img src="/images/libro-sin-fondo-480.png" alt="" width="480" height="640" loading="lazy"/>
  </picture>
  <em class="book-teaser-title">{book.title}</em>
</a>
