---
import Icon from './Icon.astro';
import { site } from '../config/site';
---
<footer><div class="container footer-main"><a class="brand" href="/"><span class="brand-name">Jure Ramos<span class="brand-dot">.</span></span><span class="brand-caption">ESCRIBANÍA</span></a><p>Asesoramiento notarial y legal general.<br/>{site.city}, desde {site.since}.</p><div><span>Esc. {site.person}</span><span>Registro Notarial N.º {site.registration}</span></div></div><div class="container footer-bottom"><p>© {new Date().getFullYear()} Escribanía Jure Ramos</p><p>{site.address} · {site.city}</p><p>Actualizado: {new Intl.DateTimeFormat('es-AR', { timeZone: 'UTC' }).format(new Date(site.updated))}</p></div></footer>
<a class="floating-wa" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="Contactar a Escribanía Jure Ramos por WhatsApp"><Icon name="whatsapp" size={26}/><span>WhatsApp</span></a>
