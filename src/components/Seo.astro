---
import type { Graph, Notary, Person, WebSite, FAQPage } from 'schema-dts';
import { site } from '../config/site';
interface Props { title?: string; description?: string; noindex?: boolean; }
const { title = 'Escribanía en Nueva Córdoba | Solange Jure Ramos · Registro 132', description = 'Asesoramiento notarial y legal general en Nueva Córdoba desde 2002. Esc. Solange Jure Ramos, Registro 132. Inmuebles, sociedades, familia y certificaciones.', noindex = false } = Astro.props;
const business: Notary = { '@type':'Notary', '@id':`${site.url}/#escribania`, name:site.name, url:site.url, telephone:site.phoneHref, email:site.email, image:`${site.url}/images/solange-jure-ramos.webp`, foundingDate:'2002', founder:{'@id':`${site.url}/#solange`}, address:{'@type':'PostalAddress',streetAddress:site.address,addressLocality:site.city,addressRegion:'Córdoba',postalCode:site.postalCode,addressCountry:'AR'}, geo:{'@type':'GeoCoordinates',latitude:site.latitude,longitude:site.longitude}, hasMap:site.maps, openingHoursSpecification:site.openingHours.map(hours=>({'@type':'OpeningHoursSpecification' as const,dayOfWeek:[...hours.days],opens:hours.opens,closes:hours.closes})) };
const person: Person = {'@type':'Person','@id':`${site.url}/#solange`,name:site.person,jobTitle:'Escribana',description:'Escribana titular del Registro Notarial N.º 132, en ejercicio desde 2002. Doctora en Derecho y magíster en Derecho Empresario.',worksFor:{'@id':`${site.url}/#escribania`}};
const website: WebSite = {'@type':'WebSite','@id':`${site.url}/#website`,name:site.name,url:site.url,inLanguage:'es-AR',publisher:{'@id':`${site.url}/#escribania`}};
const faq: FAQPage = {'@type':'FAQPage','@id':`${site.url}/#preguntas`,mainEntity:site.faq.map(item=>({'@type':'Question',name:item.q,acceptedAnswer:{'@type':'Answer',text:item.a}}))};
const graph: Graph = {'@context':'https://schema.org','@graph':[business,person,website,faq]};
const canonical = new URL(Astro.url.pathname, site.url).href;
---
<title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
{noindex && <meta name="robots" content="noindex,follow"/>}
<meta property="og:type" content="website"/><meta property="og:locale" content="es_AR"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:site_name" content={site.name}/><meta property="og:image" content={`${site.url}/images/compartir.jpg`}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta name="twitter:card" content="summary_large_image"/>
<link rel="alternate" type="text/markdown" href="/index.md" title="Contenido en Markdown"/><link rel="describedby" href="/llms.txt" type="text/plain"/>
{!noindex && <script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g,'\\u003c')}/>}
