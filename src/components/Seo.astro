---
import { site } from '../config/site';
import { serviceMarkdownPath, type ServicePage } from '../config/service-pages';
import { structuredData } from '../lib/structured-data';
interface Props { title?: string; description?: string; noindex?: boolean; service?: ServicePage; markdown?: string; }
const { title = 'Escribanía en Nueva Córdoba | Solange Jure Ramos · Registro 132', description = 'Asesoramiento notarial y legal general en Nueva Córdoba desde 2002. Esc. Solange Jure Ramos, Registro 132. Inmuebles, sociedades, familia y certificaciones.', noindex = false, service } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const markdown = Astro.props.markdown ?? (service ? serviceMarkdownPath(service) : '/index.md');
---
<title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
{noindex && <meta name="robots" content="noindex,follow"/>}
<meta property="og:type" content="website"/><meta property="og:locale" content="es_AR"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:site_name" content={site.name}/><meta property="og:image" content={`${site.url}/images/compartir.jpg`}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta name="twitter:card" content="summary_large_image"/>
{!noindex && <><link rel="alternate" type="text/markdown" href={markdown} title="Contenido en Markdown"/><link rel="describedby" href="/llms.txt" type="text/plain"/></>}
{!noindex && <script type="application/ld+json" set:html={JSON.stringify(structuredData(canonical, title, service)).replace(/</g,'\\u003c')}/>}
