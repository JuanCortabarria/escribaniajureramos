---
interface Props { year: number; prefix?: string }
const { year, prefix = 'Desde' } = Astro.props;
---
<span class="year-counter" data-year-counter={year}>
  <span class="year-accessible">{prefix} {year}</span>
  <span aria-hidden="true">{prefix} <span class="year-value">{year}</span></span>
</span>

<style>
  .year-accessible { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .year-value { display: inline-block; min-width: 4ch; font-variant-numeric: tabular-nums; }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('[data-year-counter]').forEach(counter => {
    const value = counter.querySelector<HTMLElement>('.year-value');
    const target = Number(counter.dataset.yearCounter);
    const motionDisabled = () => reducedMotion.matches || document.documentElement.dataset.motionPaused === 'true';
    if (!value || !Number.isFinite(target) || motionDisabled() || !('IntersectionObserver' in window)) return;

    const observer = new IntersectionObserver(entries => {
      if (!entries.some(entry => entry.isIntersecting)) return;
      observer.disconnect();
      if (motionDisabled()) return;

      let frame = 0;
      const finish = () => {
        cancelAnimationFrame(frame);
        value.textContent = String(target);
        reducedMotion.removeEventListener('change', finish);
        pauseObserver.disconnect();
      };
      const pauseObserver = new MutationObserver(() => { if(motionDisabled()) finish(); });
      pauseObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-motion-paused'] });
      reducedMotion.addEventListener('change', finish);
      const start = performance.now();
      const initialYear = 1000;
      value.textContent = String(initialYear);
      const tick = (now: number) => {
        const progress = Math.min((now - start) / 1200, 1);
        value.textContent = String(Math.floor(initialYear + (target - initialYear) * (1 - (1 - progress) ** 3)));
        if (progress < 1) frame = requestAnimationFrame(tick);
        else finish();
      };
      frame = requestAnimationFrame(tick);
    }, { threshold: 0.5 });
    observer.observe(counter);
  });
</script>
