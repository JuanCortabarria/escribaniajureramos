---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { consultation, servicePages, servicePath } from '../config/service-pages';
import Icon from '../components/Icon.astro';
import YearCounter from '../components/YearCounter.astro';
import { site } from '../config/site';

---
<Layout>
<a href="#contenido" class="skip-link">Ir al contenido</a>
<Header/>
<main id="contenido">
<section class="hero" aria-labelledby="hero-title"><div class="container hero-grid">
 <div class="hero-copy"><p class="eyebrow light"><span class="line"></span> CÓRDOBA · DESDE 2002</p>
 <h1 id="hero-title">Escribanía en<br/><em>Nueva Córdoba.</em></h1>
 <p class="hero-description">Asesoramiento notarial y legal general.</p>
 <a class="button button-gold" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">Coordiná tu consulta <Icon name="arrow" size={19}/></a>
 <p class="hero-person">Esc. Solange Jure Ramos <span>Registro Notarial N.º 132</span></p>
 </div>
 <div class="hero-visual"><div class="photo-frame"><picture><source srcset="/images/portada-jure-ramos-420.avif 420w, /images/portada-jure-ramos-800.avif 800w" sizes="(max-width: 760px) calc(100vw - 65px), 500px" type="image/avif"/><source srcset="/images/portada-jure-ramos-420.webp 420w, /images/portada-jure-ramos-800.webp 800w" sizes="(max-width: 760px) calc(100vw - 65px), 500px" type="image/webp"/><img src="/images/portada-jure-ramos.jpg" alt="Interior de oficina con escritorio, sillas y el nombre Jure Ramos en la pared" width="1122" height="1402" fetchpriority="high"/></picture></div><div class="photo-note"><span class="note-icon"><Icon name="seal" size={27}/></span><div>Atención personalizada desde el primer encuentro.</div></div></div>
</div><div class="container hero-bottom"><span>PARTICULARES · EMPRESAS · INMOBILIARIAS</span><a href="#servicios">Ver áreas de práctica <Icon name="down" size={16}/></a></div></section>
<div class="trust-strip"><div class="container trust-grid"><div><span class="trust-number"><YearCounter year={site.since}/></span><span>Trayectoria en el ejercicio notarial</span></div><div><Icon name="seal" size={29}/><p>Registro Notarial <strong>N.º 132</strong></p></div><div><Icon name="family" size={29}/><p>Atención directa <strong>con la escribana</strong></p></div></div></div>
<section class="section about" id="escribana" aria-labelledby="about-title"><div class="container about-grid"><div class="portrait-wrap"><picture><source srcset="/images/solange-jure-ramos.avif" type="image/avif"/><source srcset="/images/solange-jure-ramos.webp" type="image/webp"/><img src="/images/solange-jure-ramos.jpg" alt="Solange Jure Ramos trabajando en su escribanía" width="1237" height="1750" loading="lazy"/></picture><div class="portrait-label"><span>Solange Jure Ramos</span><small>Registro Notarial N.º 132</small></div></div><div class="about-copy"><p class="eyebrow">01 / LA ESCRIBANA</p><h2 id="about-title">Solange<br/><em>Jure Ramos.</em></h2><p class="registration">ESCRIBANA TITULAR · REGISTRO N.º 132</p><p class="about-intro">Escribana titular del Registro Notarial N.º 132, en ejercicio desde 2002.</p><p>Accedió a la titularidad por concurso de antecedentes y oposición. Su actividad profesional comprende el asesoramiento notarial y legal general, junto con la docencia universitaria y la investigación jurídica.</p><ul class="credentials">{site.credentials.map(item=><li><Icon name="check" size={17}/>{item}</li>)}</ul><details class="bio-more"><summary>Más sobre su trayectoria <Icon name="down" size={16}/></summary><p>Integra el Instituto de la Empresa de la Academia Nacional de Derecho y Ciencias Sociales de Córdoba y el Ateneo de la Academia Nacional del Notariado. Es delegada en Córdoba de la Universidad Notarial Argentina, docente de posgrado y autora de publicaciones especializadas.</p></details></div></div></section>
<section class="section location" id="ubicacion" aria-labelledby="location-title"><div class="container location-grid"><div><p class="eyebrow">02 / UBICACIÓN</p><h2 id="location-title">Ubicación y horarios</h2><address><div class="contact-row"><Icon name="pin"/><div><strong>{site.address}</strong><span>{site.postalCode} · Córdoba, Argentina</span></div></div><div class="contact-row"><Icon name="clock"/><div><strong>{site.hours}</strong><span>{consultation.visit}</span></div></div><div class="contact-row"><Icon name="phone"/><div><a href={`tel:${site.phoneHref}`}>{site.phone}</a><span>WhatsApp: <a href={site.whatsappUrl}>{site.whatsapp}</a></span></div></div><div class="contact-row"><Icon name="mail"/><a class="email-link" href={`mailto:${site.email}`}>{site.email}</a></div></address><a class="text-link" href={site.maps} target="_blank" rel="noopener noreferrer">Cómo llegar <Icon name="arrow" size={19}/></a></div><div class="map-panel"><div class="map-preview"><div class="map-block b1"></div><div class="map-block b2"></div><div class="map-block b3"></div><div class="map-block b4"></div><span class="map-street">PARANÁ</span><div class="map-marker"><Icon name="pin" size={32}/><span>Jure Ramos<span>Paraná 540</span></span></div><div class="map-load"><p>Paraná 540 · Nueva Córdoba</p><button id="load-map" class="button button-navy">Ver mapa de Google <Icon name="arrow" size={17}/></button><small>El mapa se carga solo cuando lo abrís.</small></div></div></div></div></section>
<section class="section faq" id="preguntas" aria-labelledby="faq-title"><div class="container faq-grid"><div><p class="eyebrow">03 / PREGUNTAS FRECUENTES</p><h2 id="faq-title">Preguntas frecuentes</h2><p>Información sobre escrituras, poderes, certificaciones y documentos para uso en el exterior.</p><a class="text-link" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">Consultanos por WhatsApp <Icon name="arrow" size={19}/></a></div><div class="faq-list">{site.faq.map((item,i)=><details><summary><span class="faq-index">0{i+1}</span><h3>{item.q}</h3><span class="plus" aria-hidden="true"></span></summary><p>{item.a}</p></details>)}</div></div></section>
<section class="approach section"><div class="container"><p class="eyebrow">ATENCIÓN PROFESIONAL</p><div class="approach-grid"><h2>Modalidad de atención</h2><ol class="steps"><li><span>01</span><div><h3>Consulta inicial</h3><p>Descripción de la gestión por WhatsApp y reunión cuando corresponde.</p></div></li><li><span>02</span><div><h3>Documentación</h3><p>Información sobre los antecedentes y documentos necesarios.</p></div></li><li><span>03</span><div><h3>Gestión notarial</h3><p>Coordinación de las actuaciones correspondientes a cada trámite.</p></div></li></ol></div></div></section>
<section class="section services" id="servicios" aria-labelledby="services-title"><div class="container">
 <div class="section-heading"><div><p class="eyebrow">04 / ÁREAS DE PRÁCTICA</p><h2 id="services-title">Servicios notariales</h2></div></div>
 <div class="services-grid">{site.services.map((service,i)=> {
   const detail = servicePages.find(page=>page.serviceIndex===i)!;
   return <a class="service-card" href={servicePath(detail)} aria-labelledby={`service-title-${i}`}>
     <div class="card-top"><Icon name={service.icon} size={28}/><span>0{i+1}</span></div>
     <p class="service-label">{service.label}</p><h3 id={`service-title-${i}`}>{service.title}</h3>
     <span class="card-navigation" aria-hidden="true"><Icon name="arrow" size={22}/></span>
   </a>;
 })}
 <aside class="service-help"><span class="help-mark" aria-hidden="true"><Icon name="seal" size={28}/></span><h3>Consultas notariales</h3><a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">Consultar por WhatsApp <Icon name="arrow" size={20}/></a></aside></div>
</div></section>
<section class="closing"><picture><source srcset="/images/asesoramiento.avif" type="image/avif"/><source srcset="/images/asesoramiento.webp" type="image/webp"/><img src="/images/asesoramiento.jpg" alt="" width="528" height="606" loading="lazy"/></picture><div class="container closing-inner"><div><p class="eyebrow light">CONTACTO</p><h2>Contacto con la escribanía</h2><p>Para consultas notariales y coordinación de entrevistas, comunicate por WhatsApp.</p></div><a class="button button-gold" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={21}/> Escribinos por WhatsApp <Icon name="arrow" size={19}/></a></div></section>
</main>
<Footer/>
<script>
 document.querySelector('#load-map')?.addEventListener('click',()=>{ const panel=document.querySelector('.map-panel'); if(!panel)return; const frame=document.createElement('iframe');frame.title='Ubicación de Escribanía Jure Ramos en Córdoba';frame.src='https://maps.google.com/maps?q=-31.4245341,-64.1799683&z=16&output=embed';frame.referrerPolicy='no-referrer';frame.allowFullscreen=true; panel.replaceChildren(frame); });
</script>
</Layout>
