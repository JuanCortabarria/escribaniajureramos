---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../config/site';
import { consultation, servicePages, servicePath, serviceWhatsApp, type ServicePage } from '../../config/service-pages';
export function getStaticPaths() { return servicePages.map(service => ({ params: { slug: service.slug }, props: { service } })); }
interface Props { service: ServicePage; }
const { service } = Astro.props;
const related = servicePages.filter(page => page.slug !== service.slug);
---
<Layout title={service.seoTitle} description={service.description} service={service}>
<a class="skip-link" href="#contenido">Ir al contenido</a><Header/>
<main id="contenido">
<section class="service-hero"><div class="container">
<nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">Inicio</a><span aria-hidden="true">/</span><span aria-current="page">{service.title}</span></nav>
<p class="eyebrow light">ESCRIBANÍA JURE RAMOS · CÓRDOBA</p><h1>{service.title}</h1><p class="service-lead">{service.introduction}</p>
<a class="button button-gold" href={serviceWhatsApp(service)} target="_blank" rel="noopener noreferrer">Consultar por WhatsApp <Icon name="arrow" size={19}/></a>
</div></section>
<div class="container service-body"><div class="service-prose">
<section aria-labelledby="scope-title"><p class="eyebrow">ACTUACIONES</p><h2 id="scope-title">{service.scopeTitle}</h2><ul class="scope-list">{service.scope.map(item=><li><Icon name="check" size={18}/>{item}</li>)}</ul></section>
<section aria-labelledby="guidance-title"><h2 id="guidance-title">{service.guidanceTitle}</h2><p>{service.guidance}</p></section>
<section aria-labelledby="attention-title"><h2 id="attention-title">Modalidad de atención</h2><p>{service.attention}</p></section>
<section aria-labelledby="budget-title"><h2 id="budget-title">Solicitud de presupuesto</h2><p>{consultation.budget}</p><a class="text-link" href={serviceWhatsApp(service)} target="_blank" rel="noopener noreferrer">Consultar esta gestión <Icon name="arrow" size={18}/></a></section>
<section aria-labelledby="questions-title"><h2 id="questions-title">Preguntas frecuentes</h2><div class="faq-list service-faq">{service.faq.map((item,i)=><details><summary><span class="faq-index">0{i+1}</span><h3>{item.q}</h3><span class="plus" aria-hidden="true"></span></summary><p>{item.a}</p></details>)}</div></section>
</div><aside class="service-sidebar" aria-labelledby="office-title">
<p class="eyebrow">ATENCIÓN PROFESIONAL</p><h2 id="office-title">Solange Jure Ramos</h2><p class="sidebar-registration">Escribana titular · Registro N.º {site.registration}</p>
<div class="sidebar-contact"><Icon name="pin" size={21}/><address>{site.address}<br/>Nueva Córdoba · Córdoba</address></div>
<div class="sidebar-contact"><Icon name="clock" size={21}/><p>{site.hours}</p></div>
<p class="sidebar-visit">{consultation.visit}</p><a class="button button-navy" href={serviceWhatsApp(service)} target="_blank" rel="noopener noreferrer">Consultar por WhatsApp <Icon name="arrow" size={17}/></a>
<a class="text-link" href={`tel:${site.phoneHref}`}>{site.phone}</a><a class="sidebar-profile" href="/#escribana">Trayectoria profesional <Icon name="arrow" size={16}/></a>
</aside></div>
<section class="related-services section" aria-labelledby="related-title"><div class="container"><p class="eyebrow">ÁREAS DE PRÁCTICA</p><h2 id="related-title">Otros servicios notariales</h2><div class="related-grid">{related.map(page=><a href={servicePath(page)}><h3>{page.title}</h3><Icon name="arrow" size={22}/></a>)}</div><a class="text-link" href="/#servicios">Ver todas las áreas de práctica <Icon name="arrow" size={18}/></a></div></section>
</main><Footer/>
</Layout>
